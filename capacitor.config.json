{
  "appId": "com.mrfstudios.learnpath",
  "appName": "Learnpath",
  "webDir": "out",
  "server": {
    "url": "https://learnpathnow.com",
    "cleartext": false
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#0a0b0f"
  },
  "android": {
    "backgroundColor": "#0a0b0f",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0b0f",
      "showSpinner": false,
      "androidSpinnerStyle": "none",
      "launchAutoHide": true,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0a0b0f"
    }
  }
}